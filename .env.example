# ============================================================
# GO CARE DRUG — production environment variables
# Copy to Render / Railway / VPS env settings. NEVER commit real values.
# ============================================================

# --- required ---
NODE_ENV=production
PORT=8000

# Random 32+ char secret. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# App refuses to boot in production without this.
SESSION_SECRET=paste-random-secret-here

# --- paths (persistent disk on the host) ---
# Render example with a disk mounted at /var/gocare-data:
#   DATA_DIR=/var/gocare-data/db
#   UPLOAD_DIR=/var/gocare-data/uploads
# Local dev: leave unset (uses ./data and ./uploads).
DATA_DIR=
UPLOAD_DIR=

# --- first admin (only used when the database is empty/fresh) ---
# On an existing database these are ignored. If ADMIN_PASSWORD is unset,
# a random password is generated and printed once in the server logs —
# copy it immediately, then change it in Admin Profile.
ADMIN_EMAIL=admin@gocaredrug.in
# ADMIN_PASSWORD=set-a-strong-password-here

# --- data migration ---
# Existing local SQLite data is preserved by copying this repo's
# data/gocare.db to $DATA_DIR/gocare.db on the host (via SSH/scp),
# or: Admin Panel → (backup endpoint) GET /api/admin/backup/download
# to export, then place the file on the host and restart.
